# Copy to .env on the Pi (chmod 600) and fill in a real token.
# Generate one with:  openssl rand -hex 24
# NEVER commit the filled-in file.
M5GW_TOKEN=replace-me-with-openssl-rand-hex-24

# Optional overrides (defaults shown)
#M5GW_PORT=5010
#M5GW_BIND=0.0.0.0
#M5GW_FETCH_TIMEOUT=1.5
#M5GW_CACHE_TTL=1.0
#M5GW_SLOW_TTL=60.0
