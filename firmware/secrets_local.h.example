// Optional: bake credentials into a *local* build.
//
// Copy to `secrets_local.h`, fill in, and build the `cardputer-local`
// environment. The device then skips the setup screen and joins the network
// on first boot — convenient for your own device, and only for that.
//
//   cp secrets_local.h.example secrets_local.h
//   $EDITOR secrets_local.h
//   pio run -e cardputer-local -t upload
//
// ⚠️ The resulting binary contains these strings in clear text. Anyone with
//    the device, or with the .bin, can read them out. Never publish a binary
//    built this way, never attach one to a release, and never commit
//    `secrets_local.h` — .gitignore blocks it, but the habit matters more
//    than the net.
//
// The default `cardputer` environment ignores this file entirely and asks on
// the device instead, which is what the published binaries are built from.

#pragma once

#define M5SH_WIFI_SSID   "your-network"
#define M5SH_WIFI_PASS   "your-password"

// Gateway token from the Pi:
//   ssh <pi> 'grep M5GW_TOKEN /home/pi/apps/m5-gateway/.env'
#define M5SH_GW_TOKEN    "paste-the-token"

// Optional. Leave empty to find the gateway over mDNS.
#define M5SH_GW_HOST     ""
#define M5SH_GW_PORT     5010
